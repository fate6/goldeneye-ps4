# PS4 target setup, included at the end of the top-level CMakeLists.txt.
#
# Configure with DolphinPS4's toolchain (toolchain/ps4-love-modern.cmake: clang 21
# + libc++ 21 on OpenOrbis) and its ps4-love-style.cmake included into the
# project (CMAKE_PROJECT_ge007_INCLUDE): that provides the PS4 runtime (heap,
# thread-exit fixes, crash log, sampler), the patched linker script, mmap/malloc
# wraps, ps4_add_eboot() and ps4_link_mesa(). See tools_ps4/build.sh.

set(GE_PS4_DATA_DIR "/data/GoldenEye64")

# DolphinPS4's runtime writes its trace, crash log and profiler output to
# /data/DolphinPS4: build copies that write to our folder, track more threads,
# and take the heap from direct memory first (the x360 port found that taking
# 512 MiB of the system flexible pool starves the kernel and hangs the console).
set(GE_PS4_PORT_DIR "${CMAKE_BINARY_DIR}/ps4-port")
set(GE_PS4_RUNTIME_SOURCES "")
foreach(src ${PS4_RUNTIME_SOURCES})
  get_filename_component(name "${src}" NAME)
  file(READ "${src}" text)
  string(REPLACE "/data/DolphinPS4" "${GE_PS4_DATA_DIR}" text "${text}")
  # Static buffers count against the image's 0x01000000 limit (see the link
  # script note below): 8 sampled threads, no 1 MiB copy buffer (it is chunked).
  string(REPLACE "constexpr int kMaxThreads = 4;" "constexpr int kMaxThreads = 8;" text "${text}")
  string(REPLACE "constexpr int kMaxWatched = 16," "constexpr int kMaxWatched = 64," text "${text}")
  string(REPLACE "static uint8_t copy[0x100000];" "static uint8_t copy[0x10000];" text "${text}")
  string(REPLACE
    "    // Preferred: the system flexible memory pool, leaving regular flexible memory to Piglet."
    "    // GoldenEye 64: direct memory first (leaves the system pool to the kernel).\n    const size_t directFirstSizes[] = {512 * MB, 256 * MB};\n    for (size_t direct : directFirstSizes) {\n        if (mspace msp = createDirectHeap(direct))\n            return msp;\n    }\n    // Preferred: the system flexible memory pool, leaving regular flexible memory to Piglet."
    text "${text}")
  file(WRITE "${GE_PS4_PORT_DIR}/${name}" "${text}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
  list(APPEND GE_PS4_RUNTIME_SOURCES "${GE_PS4_PORT_DIR}/${name}")
endforeach()
# Image layout. The PS4 loads the eboot at 0x400000. fast3d's seg_addr() reads
# display-list values below 0x800000 as offsets into the 8 MB N64 RAM (the game
# uses all of it: e.g. 0x700000 and 0x760000 on the file-select screen) and
# values from 0x01000000 with a segment number set as segment addresses. So
# everything a display list can point at in the image - .rodata, .data, .bss -
# must lie in [0x800000, 0x01000000): start .rodata at link address 0x400000
# (code needs no such care), and keep the image under 16 MiB.
# ps4_platform.c checks this at startup.
file(READ "${PS4_LINK_SCRIPT}" _ge_link)
if(NOT _ge_link MATCHES "GoldenEye 64 rodata")
  string(FIND "${_ge_link}" "\t.rodata : ALIGN(0x10) {" _ge_rodata_pos)
  if(_ge_rodata_pos EQUAL -1)
    message(FATAL_ERROR "Unexpected ${PS4_LINK_SCRIPT}: no .rodata section to move")
  endif()
  string(REPLACE "\t.rodata : ALIGN(0x10) {"
    "\t/* GoldenEye 64 rodata: at 0x400000 = runtime 0x800000 (port/ps4/ps4.cmake) */\n\t. = MAX(., 0x400000);\n\t.rodata : ALIGN(0x10) {"
    _ge_link "${_ge_link}")
  file(WRITE "${PS4_LINK_SCRIPT}" "${_ge_link}")
endif()

# ps4_dlmalloc.c includes third_party/dlmalloc/malloc.c relative to the runtime.
list(GET PS4_RUNTIME_SOURCES 0 _ge_ps4_first_runtime_src)
get_filename_component(_ge_ps4_runtime_dir "${_ge_ps4_first_runtime_src}" DIRECTORY)
# The runtime and port/ps4/ps4_platform.c are ordinary C/C++: build them
# without the game's include path (its N64 stdio.h/stdlib.h would shadow the C
# library's) and without the game's flags/defines.
add_library(ge007_ps4_platform OBJECT ${GE_PS4_RUNTIME_SOURCES}
  "${CMAKE_SOURCE_DIR}/port/ps4/ps4_platform.c")
set_property(TARGET ge007_ps4_platform PROPERTY INCLUDE_DIRECTORIES "${_ge_ps4_runtime_dir}")
set_property(TARGET ge007_ps4_platform PROPERTY COMPILE_OPTIONS "-Wall;-Wno-unused-but-set-variable")
set_property(TARGET ge007_ps4_platform PROPERTY COMPILE_DEFINITIONS "")
target_sources(ge007 PRIVATE $<TARGET_OBJECTS:ge007_ps4_platform>)

# C++ (fast3d, port/ps4) include order. libc++'s C wrapper headers
# (<cstddef> -> its own stddef.h -> #include_next) must come before the game's
# -I dirs, and whatever they #include_next must be the C library's header, not
# the decomp's N64 one (include/math.h, limits.h, assert.h). port/shim already
# routes stdlib/string/stddef/stdarg/sched for C++; these cover the rest.
set(GE_PS4_CXX_SHIM "${CMAKE_BINARY_DIR}/ps4-cxx-shim")
foreach(hdr math.h limits.h assert.h)
  if(hdr STREQUAL "math.h")
    set(real "${PS4_SYSROOT}/libc-overlay/math.h")
  else()
    set(real "${OPENORBIS}/include/${hdr}")
  endif()
  file(WRITE "${GE_PS4_CXX_SHIM}/${hdr}"
    "/* Generated by port/ps4/ps4.cmake: C++ TUs get the C library's ${hdr}. */\n#include \"${real}\"\n")
endforeach()
# The toolchain passes c++/v1 as -isystem, which ranks it after every -I (and
# a dir given both ways counts as -isystem): drop that flag here and list
# c++/v1 first for each C++ target instead. CMake also drops include dirs it
# lists as the compiler's implicit ones, so take it off that list too.
string(REPLACE "-isystem ${PS4_SYSROOT}/include/c++/v1" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
list(REMOVE_ITEM CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES "${PS4_SYSROOT}/include/c++/v1")
set_property(TARGET ge007_ps4_platform PROPERTY INCLUDE_DIRECTORIES
  "$<$<COMPILE_LANGUAGE:CXX>:${PS4_SYSROOT}/include/c++/v1>" "${_ge_ps4_runtime_dir}")
target_include_directories(ge007 BEFORE PRIVATE
  "$<$<COMPILE_LANGUAGE:CXX>:${PS4_SYSROOT}/include/c++/v1>"
  "$<$<COMPILE_LANGUAGE:CXX>:${GE_PS4_CXX_SHIM}>")

# .data.rel.ro padding against PacBrew create-fself's duplicate-segment bug
# (CE-41839-5; check-oelf fails the build). Change when check-oelf fails.
set(GE_PS4_RELRO_PAD 0 CACHE STRING "PS4: bytes of .data.rel.ro padding")
set_source_files_properties("${CMAKE_SOURCE_DIR}/port/ps4/ps4_relro_pad.cpp" PROPERTIES
  COMPILE_DEFINITIONS GE_PS4_RELRO_PAD=${GE_PS4_RELRO_PAD})

# src/str.c defines the game's own strtol, which collides with the static
# libc's object (other libc users pull it in). On Linux/Windows the game's
# copy overrides the shared libc for the whole program; here the game's C
# code keeps using it under another name and the C library keeps its own.
target_compile_definitions(ge007 PRIVATE $<$<COMPILE_LANGUAGE:C>:strtol=ge_n64_strtol>)

# Vulkan: Mesa RADV on GNM runs from its own module, sce_module/libGE64Radv.prx
# (tools_ps4/build-radv-prx.sh, packaged by tools_ps4/package.sh): linked in,
# its ~26 MB would push the game's data above 0x01000000 (portaddr.h). The
# eboot only needs the Vulkan headers.
set(GE_PS4_MESA_SRC "$ENV{HOME}/dolphinps4-build/src/mesa" CACHE PATH "Mesa source (Vulkan headers)")
target_include_directories(ge007 PRIVATE "${GE_PS4_MESA_SRC}/include")

target_link_libraries(ge007
  SceSysmodule SceSystemService SceUserService SceAudioOut ScePad SceVideoOut
  ScePigletv2VSH   # referenced by SDL's (unused) PS4 video driver
  "${OPENORBIS}/usr/lib/libsamplerate.a"   # SDL's audio resampler
  pthread)

ps4_add_eboot(ge007)
