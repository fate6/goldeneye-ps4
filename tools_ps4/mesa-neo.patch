--- a/ac_ps4_drm.c
+++ b/ac_ps4_drm.c
@@ -93,6 +93,76 @@
 #define PS4_GB_ADDR_CONFIG 0x00011003
 #define PS4_MC_ARB_RAMCFG 0x2 /* 16 banks */
 
+/* GE PS4 Neo: a PS4 Pro runs an app with param.sfo ATTRIBUTE bit 23 in Neo mode (36 CUs at
+ * 911 MHz). The tiling above stays valid there: on the console, Neo mode with these tables
+ * renders correctly, while the 16-pipe P16_32x32_8x16 tables (shadPS4's alternate per-mode
+ * attributes) broke every depth buffer. Only the reported clock changes. */
+int32_t sceKernelIsNeoMode(void);
+
+static bool
+ps4_neo(void)
+{
+   static int neo = -1;
+   if (neo < 0)
+      neo = sceKernelIsNeoMode() == 1;
+   return neo;
+}
+
+/* GE PS4 raster experiment (env GE_RASTER, read by ac_get_raster_config too):
+ *  0 = Mesa's Bonaire config, 0x16000012 ("2 SEs / 4 RBs": one packer per SE);
+ *  1 = 2 SEs / 8 RBs, Tahiti's 0x2a00126a (both packers);
+ *  2 = Neo only: 4 SEs / 16 RBs / 36 CUs reported, Hawaii's 0x3a00161a + 0x2e;
+ *  3 = Neo only: as 2, with 16-pipe tiling (P16_32x32_8x16 tables from shadPS4's
+ *      alternate per-mode rules, GB_ADDR_CONFIG 16 pipes / 4 SEs), as Hawaii;
+ *  4 = Neo only: 4 SEs / 16 RBs / 36 CUs reported, and the raster config is not
+ *      written at all (ac_cmdbuf.c): the system's CLEAR_STATE value stays, as for
+ *      GNM apps, whose firmware init sequences (shadPS4 captures) never set it;
+ *  5 = as 0, but the raster config is not written (control for 4);
+ *  6 = Neo only: as 4, with the 16-pipe tables, and ac_descriptors.c sets the Neo
+ *      ALT_TILE_MODE bit (CB_COLOR_INFO bit 31, texture dword 6 bit 24; bit
+ *      positions from OpenGNM) so the hardware reads its alternate tile table;
+ *  (7, the GNM driver Neo init register writes on top of 4, changed nothing: removed.) */
+int ac_ps4_raster_mode(void);
+
+int
+ac_ps4_raster_mode(void)
+{
+   static int mode = -1;
+   if (mode < 0) {
+      const char *e = getenv("GE_RASTER");
+      mode = e ? atoi(e) : 0;
+      if (mode < 0 || mode > 6 || ((mode >= 6 || (mode >= 2 && mode <= 4)) && !ps4_neo()))
+         mode = 0;
+   }
+   return mode;
+}
+
+static unsigned
+ps4_num_se(void)
+{
+   const int mode = ac_ps4_raster_mode();
+   return (mode >= 2 && mode <= 4) || mode >= 6 ? 4 : 2;
+}
+
+static const uint32_t ps4_neo_tile_modes[32] = {
+   0x00800410, 0x00800c10, 0x00801410, 0x00801c10, 0x00802410, 0x00800408, 0x00801418,
+   0x00802418, 0x00000404, 0x00000408, 0x02000410, 0x02000414, 0x02000418, 0x00400408,
+   0x02400410, 0x02400430, 0x02400414, 0x02400418, 0x0240042c, 0x0100040c, 0x0100041c,
+   0x01000434, 0x01000424, 0x01000428, 0x0100043c, 0x01000420, 0x01000438, 0, 0, 0, 0, 0,
+};
+static const uint32_t ps4_neo_macrotile_modes[16] = {
+   0x98, 0x98, 0x84, 0x84, 0x80, 0x80, 0x40, 0x00, 0xd8, 0x98, 0x84, 0x80, 0x40, 0x40, 0x00, 0x00,
+};
+
+static bool
+ps4_p16(void)
+{
+   return ac_ps4_raster_mode() == 3 || ac_ps4_raster_mode() == 6;
+}
+#define PS4_TILE_MODES (ps4_p16() ? ps4_neo_tile_modes : ps4_tile_modes)
+#define PS4_MACROTILE_MODES (ps4_p16() ? ps4_neo_macrotile_modes : ps4_macrotile_modes)
+#define PS4_ADDR_CONFIG (ps4_p16() ? 0x00012004 : PS4_GB_ADDR_CONFIG)
+
 struct amdgpu_bo {
    uint32_t handle;
    uint64_t size;
@@ -928,6 +999,8 @@
