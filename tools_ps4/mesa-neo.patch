--- a/ac_ps4_drm.c
+++ b/ac_ps4_drm.c
@@ -93,6 +93,21 @@
 #define PS4_GB_ADDR_CONFIG 0x00011003
 #define PS4_MC_ARB_RAMCFG 0x2 /* 16 banks */
 
+/* GE PS4 Neo: a PS4 Pro runs an app with param.sfo ATTRIBUTE bit 23 in Neo mode (36 CUs at
+ * 911 MHz). The tiling above stays valid there: on the console, Neo mode with these tables
+ * renders correctly, while the 16-pipe P16_32x32_8x16 tables (shadPS4's alternate per-mode
+ * attributes) broke every depth buffer. Only the reported clock changes. */
+int32_t sceKernelIsNeoMode(void);
+
+static bool
+ps4_neo(void)
+{
+   static int neo = -1;
+   if (neo < 0)
+      neo = sceKernelIsNeoMode() == 1;
+   return neo;
+}
+
 struct amdgpu_bo {
    uint32_t handle;
    uint64_t size;
